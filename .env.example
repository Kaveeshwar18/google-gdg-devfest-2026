# Copy to .env (make setup does this). Every key is optional:
#   no ANTHROPIC_API_KEY -> mock answers (frontend still works end to end)
#   no SARVAM_API_KEY    -> /api/stt, /api/tts, /api/translate return 503 and the browser fallbacks are used

ANTHROPIC_API_KEY=
SARVAM_API_KEY=
SEARCH_API_KEY=
# Free key (no card): https://aistudio.google.com -> Get API key. Free tier is rate limited.
GEMINI_API_KEY=

# Claude models (plan section 3.2): main = reasoning/synthesis, fast = triage/extraction
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-4-5

# true = canned answers even when a key is set (frontend work, offline demo fallback)
MOCK_LLM=false

# Comma-separated. Add the deployed frontend origin here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Sarvam (empty speaker = Sarvam's default voice)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_STT_MODEL=saaras:v3

# LLM backend: auto = Claude if keyed, else Gemini if keyed, else local Ollama if running, else mock
# (anthropic | gemini | ollama | mock to force one)
# Ordered model chains, best first. The free tier's DAILY quota is per model (gemini-3.8-flash: 20 requests/day),
# so when one runs out the next answers. Confirm ids in AI Studio; gemini-2.5-flash 404s for new keys.
GEMINI_MODELS_MAIN=gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_MODELS_FAST=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-3.5-flash
GEMINI_RPM=8
LLM_PROVIDER=auto
# Local fallback (free, offline). `ollama pull qwen2.5:3b` (1.9 GB). Weaker than Claude: demos and dev only.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
